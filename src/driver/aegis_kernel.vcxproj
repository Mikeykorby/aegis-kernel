<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration><Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1E0F0C1-0000-0000-0000-AEGISKERNELD}</ProjectGuid>
    <RootNamespace>aegis_kernel</RootNamespace>
    <TargetVersion>Windows10</TargetVersion>
    <MinimumVisualStudioVersion>15.0</MinimumVisualStudioVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <!-- Build with the installed v143 toolset but compile/link as a kernel
         driver via manual WDK paths. The WindowsKernelModeDriver10.0 toolset
         is not registered by this WDK install, so we fall back to v143. -->
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="WDKPaths">
    <WDKVER>10.0.28000.0</WDKVER>
    <WDKROOT>C:\Program Files (x86)\Windows Kits\10\</WDKROOT>
    <WDKINCLUDE>$(WDKROOT)Include\$(WDKVER)</WDKINCLUDE>
    <WDKLIB>$(WDKROOT)Lib\$(WDKVER)\km\x64</WDKLIB>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PreprocessorDefinitions>NDEBUG;_AMD64_;AMD64;_M_AMD64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(WDKINCLUDE)\km;$(WDKINCLUDE)\shared;$(WDKINCLUDE)\um;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExceptionHandling>false</ExceptionHandling>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <CompileAs>CompileAsC</CompileAs>
      <DisableSpecificWarnings>4201;4214;4100;4127;4189;4324;4996</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <GenerateManifest>false</GenerateManifest>
      <EmbedManifest>false</EmbedManifest>
      <AdditionalLibraryDirectories>$(WDKLIB);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>fltMgr.lib;ntoskrnl.lib;BufferOverflowK.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Native</SubSystem>
      <AdditionalOptions>/DRIVER /INTEGRITYCHECK /MANIFEST:NO %(AdditionalOptions)</AdditionalOptions>
      <EntryPointSymbol>DriverEntry</EntryPointSymbol>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <TargetMachine>MachineX64</TargetMachine>
      <IgnoreAllDefaultLibraries>true</IgnoreAllDefaultLibraries>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="aegis_kernel.c" />
    <ClInclude Include="aegis_kernel.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="aegis_kernel.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
